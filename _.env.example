# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://user:password@localhost:5432/financial_intelligence
SESSION_SECRET=change-me-to-a-long-random-string
PORT=5000

# First admin account created on start-up
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI-assisted extraction (optional)
ANTHROPIC_API_KEY=
FINSIGHT_AI_MODEL=claude-sonnet-5

# Review gate switch (see review_api.py)
FINSIGHT_REVIEW_GATE=
